# Football Predictor — Variabili d'ambiente
# Copia questo file in .env e compila i valori reali

# football-data.org (gratuito, 10 req/min)
FOOTBALL_DATA_ORG_KEY=your_key_here

# API-Football via RapidAPI (opzionale)
API_FOOTBALL_KEY=your_key_here

# Database path (Railway: /data/football.db)
DB_PATH=data/football.db
